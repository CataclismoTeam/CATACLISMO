{
  "name": "cataclismo",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "build": "pnpm --filter frontend build",
    "check": "pnpm --filter frontend check",
    "lint": "pnpm --filter frontend lint",
    "test": "pnpm --filter frontend test",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path config/application/prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path config/application/prettierignore",
    "check:guard": "node tools/dev-utils/guard.mjs",
    "check:links": "node tools/dev-utils/check-links.mjs",
    "check:html": "html-validate --config config/application/htmlvalidate.json dist/index.html dist/404.html ops/deployment/maintenance.html",
    "check:size": "node tools/dev-utils/check-size.mjs",
    "check:commits": "node tools/dev-utils/commit-msg.mjs --range origin/main..HEAD",
    "lighthouse": "pnpm dlx @lhci/cli@0.16.1 autorun --config=config/application/lighthouserc.json",
    "test:e2e": "playwright test --config config/application/playwright.config.ts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "html-validate": "11.21.1",
    "lefthook": "2.2.2",
    "prettier": "3.10.1"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  }
}
